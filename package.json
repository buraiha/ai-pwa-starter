{
  "name": "ai-pwa-starter",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.15.0",
  "type": "module",
  "scripts": {
    "dev": "node dev.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server.mjs",
    "test": "pnpm test:client && pnpm test:server",
    "test:client": "vitest run",
    "test:server": "node --test server/*.test.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "dexie": "^4.0.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "fake-indexeddb": "^6.0.1",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vitest": "^3.1.4"
  }
}
